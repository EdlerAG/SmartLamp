# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Force specific text files to LF
*.py text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.c text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.bin binary
*.elf binary
*.rgb565 binary
*.mbx binary
