APP_ENV=production
MAGICBOX_KEY=change-me-secret-key
DASHBOARD_PASSWORD=change-me-password
PUBLIC_SERVER_URL=http://your-server-ip:8000

# Telegram Bot
TG_BOT_TOKEN=
TG_ADMIN_ID=0
TG_GIRL_ID=0
SERVER_MANAGES_BOT=true

# Spotify OAuth2 (Vinyl Hub)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://your-server-ip:8000/api/v5/spotify/callback

# Google Calendar OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://your-server-ip:8000/api/v5/google/callback

# Voice / TTS
TTS_PROVIDER=edge
TTS_EDGE_VOICE=uk-UA-OstapNeural
VOICE_CLONE_API_KEY=
VOICE_CLONE_ID=

# Геолокація (Київ за замовчуванням)
WEATHER_LAT=50.45
WEATHER_LON=30.52
