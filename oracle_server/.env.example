# Секретний ключ (має збігатися з ORACLE_API_KEY у include/Secrets.h)
MAGICBOX_KEY=smartlamp-secret-key

# Публічна адреса твого сервера Oracle (впиши свій IP)
PUBLIC_SERVER_URL=http://YOUR_ORACLE_IP:8000

# Налаштування Telegram
TG_BOT_TOKEN=1234567890:AAH_YOUR_TELEGRAM_BOT_TOKEN
TG_ADMIN_ID=123456789
TG_GIRL_ID=123456789

# true = Telegram-бота веде сервер Oracle (миттєвий відгук + робота в блекаут)
SERVER_MANAGES_BOT=true
BLACKOUT_TIMEOUT_SEC=25.0

# Координати для точного прогнозу погоди Open-Meteo (за замовчуванням Київ / Черкаська обл.)
WEATHER_LAT=49.68
WEATHER_LON=32.33

# Опціональний безкоштовний ключ Google Gemini API (з Google AI Studio) для живих ШІ-прогнозів
GEMINI_API_KEY=

# Максимальний розмір папки медіа/кешу на диску в мегабайтах (захист 10 ГБ диска)
MAX_STORAGE_MB=500